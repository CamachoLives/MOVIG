# Cloudflare Pages - cabeceras
#
# Los bundles que genera Angular llevan hash en el nombre (main-XXXX.js,
# chunk-XXXX.js, styles-XXXX.css), asi que se pueden cachear indefinidamente.
# Los archivos del template conservan su nombre original, de modo que se
# cachean por un mes y se revalidan.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/main-*
  Cache-Control: public, max-age=31536000, immutable

/chunk-*
  Cache-Control: public, max-age=31536000, immutable

/polyfills-*
  Cache-Control: public, max-age=31536000, immutable

/styles-*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

/index.html
  Cache-Control: public, max-age=0, must-revalidate
